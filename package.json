{
  "name": "dafeiyu-pet",
  "version": "2.0.0",
  "description": "大肥鱼桌面宠物 —— 联动本地 WorkBuddy / Cursor 的透明桌宠",
  "main": "src/main/index.js",
  "productName": "大肥鱼",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron . --dev",
    "selftest": "env -u ELECTRON_RUN_AS_NODE electron . --selftest --no-sandbox --disable-gpu",
    "probe": "node scripts/probe.js",
    "icon": "env -u ELECTRON_RUN_AS_NODE electron scripts/make-icon-art.js --no-sandbox --disable-gpu && npm run icns",
    "icns": "rm -rf /tmp/dsh-icon.iconset && mkdir -p /tmp/dsh-icon.iconset && for s in 16 32 128 256 512; do sips -z $s $s assets/icon-1024.png --out /tmp/dsh-icon.iconset/icon_${s}x${s}.png >/dev/null; sips -z $((s*2)) $((s*2)) assets/icon-1024.png --out /tmp/dsh-icon.iconset/icon_${s}x${s}@2x.png >/dev/null; done && iconutil -c icns /tmp/dsh-icon.iconset -o assets/icon.icns",
    "sfx": "node scripts/make-sfx.js",
    "sfx:click": "node scripts/make-click-sfx.js",
    "dist": "CSC_IDENTITY_AUTO_DISCOVERY=false ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --dir",
    "dist:dmg": "CSC_IDENTITY_AUTO_DISCOVERY=false ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --mac dmg"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.danghaoyu.dafeiyu-pet",
    "productName": "大肥鱼",
    "copyright": "Copyright © 2026 danghaoyu",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.entertainment",
      "identity": null,
      "extendInfo": {
        "LSUIElement": false
      }
    }
  }
}
